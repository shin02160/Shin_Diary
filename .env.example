# Keep all values server-side. Never use NEXT_PUBLIC_ prefixes.
NOTION_TOKEN=
NOTION_ACTIVITIES_DATA_SOURCE_ID=
NOTION_ENTRIES_DATA_SOURCE_ID=
# Login password: at least 16 characters. Session secret: at least 32 characters.
DIARY_PASSWORD=
DIARY_SESSION_SECRET=
DIARY_APP_ORIGIN=http://localhost:3000
# Local persistent journal. Back up this file together with Notion.
DIARY_STATE_FILE=notion.sqlite

# Separate Calendar Events data source.
NOTION_CALENDAR_DATA_SOURCE_ID=

# Optional read-only Travel Hub sources shared with the Diary integration.
NOTION_TRAVEL_TRIPS_SOURCE_ID=
NOTION_TRAVEL_BOOKINGS_SOURCE_ID=
NOTION_TRAVEL_EXPENSES_SOURCE_ID=
NOTION_TRAVEL_RECEIPTS_SOURCE_ID=
